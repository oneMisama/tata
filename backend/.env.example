# Tata - Environment Variables
# Copy this to .env and fill in

# App
SECRET_KEY=change-this-to-a-random-secret-string
DEBUG=false

# Database
DATABASE_URL=sqlite:///./tata.db

# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek (cheaper alternative for Chinese)
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Default model
DEFAULT_MODEL=gpt-4o-mini

# Stripe
STRIPE_API_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
PRO_PRICE_ID=price_xxx
ENTERPRISE_PRICE_ID=price_xxx

# Redis (for Celery scheduled messages)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
